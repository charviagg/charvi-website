
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="About | Charvi Aggarwal"
      description="Get to know Charvi Aggarwal — her background in business, strategy, entrepreneurship, and social impact."
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="about-page">

      <!-- INTRODUCTION -->

      <section class="intro-section">
        <p class="eyebrow">THE PERSON BEHIND THE IDEAS / 01</p>

        <h1>A little <em>about me.</em></h1>

        <div class="intro-grid">
          <p class="intro-lead">
            I'm Charvi Aggarwal — a business graduate
            drawn to the intersection of strategy,
            entrepreneurship, and meaningful change.
          </p>

          <div class="intro-copy">
            <p>
              My journey has taken me through finance,
              investment management, corporate transformation,
              consulting, and early-stage startups.
            </p>
            <p>
              Each experience has shaped how I think about
              organizations, people, and the possibilities
              that emerge when ideas meet action.
            </p>
          </div>
        </div>
      </section>

      <!-- EDUCATION -->

      <section class="section-grid">
        <div>
          <p class="eyebrow">02 / THE FOUNDATION</p>
          <h2>Learning to see the bigger picture.</h2>
        </div>

        <div class="section-copy">
          <p>
            I graduated from Nanyang Technological University
            in Singapore with a Bachelor of Business,
            Honours (Merit), specializing in Banking &amp; Finance.
          </p>

          <p>
            While my academic foundation was rooted in finance,
            my experiences beyond the classroom drew me toward
            broader questions about how businesses operate,
            adapt, and create value.
          </p>

          <div class="detail">
            <span>EDUCATION</span>
            <strong>Nanyang Technological University, Singapore</strong>
            <p>Bachelor of Business, Honours (Merit)</p>
            <p>Specialisation in Banking &amp; Finance</p>
          </div>
        </div>
      </section>

      <!-- EXPERIENCE -->

      <section class="experience-section">
        <p class="eyebrow">03 / EXPERIENCES THAT SHAPED ME</p>

        <div class="section-heading">
          <h2>From ideas to execution.</h2>
          <p>
            Different environments, different challenges,
            and a growing appreciation for the complexity
            of building and managing organizations.
          </p>
        </div>

        <div class="experience-list">

          <article class="experience-item">
            <div class="experience-meta">
              <span>01</span>
              <span>CORPORATE TRANSFORMATION</span>
            </div>
            <div>
              <h3>Singtel</h3>
              <p class="role">Corporate Transformation Manager · 1 year</p>
              <p>
                My experience in corporate transformation
                gave me an opportunity to work within a
                large organization and deepen my understanding
                of organizational change and execution.
              </p>
            </div>
          </article>

          <article class="experience-item">
            <div class="experience-meta">
              <span>02</span>
              <span>INVESTMENT MANAGEMENT</span>
            </div>
            <div>
              <h3>Helios Capital Management</h3>
              <p class="role">Investment Intern · 4 months</p>
              <p>
                My investment internship in Singapore
                allowed me to explore business from
                an investment perspective and broaden
                my exposure to financial decision-making.
              </p>
            </div>
          </article>

          <article class="experience-item">
            <div class="experience-meta">
              <span>03</span>
              <span>CONSULTING &amp; LEADERSHIP</span>
            </div>
            <div>
              <h3>NTU PEAK × Nxera</h3>
              <p class="role">Selected Leadership Programme</p>
              <p>
                Through NTU's PEAK Leadership Programme,
                I worked on a consulting project with Nxera,
                part of Singtel, exploring challenges related
                to Power Usage Efficiency under their senior director's guidance.
              </p>
            </div>
          </article>

          <article class="experience-item">
            <div class="experience-meta">
              <span>04</span>
              <span>SOCIAL CONSULTING</span>
            </div>
            <div>
              <h3>Do Well Do Good</h3>
              <p class="role">Training Director</p>
              <p>
                As Training Director of NTU's social consulting
                club, I helped train members in consulting
                frameworks and build connections with
                partner clubs across the world.
              </p>
            </div>
          </article>

          <article class="experience-item">
            <div class="experience-meta">
              <span>05</span>
              <span>STARTUPS &amp; COMMUNITY</span>
            </div>
            <div>
              <h3>Learning through smaller teams</h3>
              <p class="role">Startup volunteering and internships</p>
              <p>
                I have also worked with early-stage startups,
                including an initiative focused on building
                friendships and community among students
                in Singapore. These experiences exposed me
                to different ways of building organizations
                around people's needs.
              </p>
            </div>
          </article>

        </div>
      </section>

      <!-- CURRENT EXPLORATION -->

      <section class="exploration-section">
        <div>
          <p class="eyebrow">04 / A QUESTION I'M EXPLORING</p>
          <h2>What happens when the problem is bigger than the idea?</h2>
        </div>

        <div class="section-copy">
          <p>
            I began exploring the issue of agricultural
            crop-residue burning with an initial idea
            for an app-based solution.
          </p>

          <p>
            But conversations with farmers and agricultural
            professionals challenged my assumptions.
            I began to understand that the problem was
            far more complex than I had anticipated.
          </p>

          <p>
            Rather than rushing toward a solution,
            I'm interested in understanding the
            constraints, incentives, and perspectives
            that shape the problem.
          </p>

          <p class="reflection">
            Sometimes, the most important part of building
            something is learning what you don't yet understand.
          </p>
        </div>
      </section>

      <!-- BEYOND WORK -->

      <section class="personal-section">
        <p class="eyebrow">05 / BEYOND THE WORK</p>
        <h2>A curious mind, in more ways than one.</h2>

        <div class="personal-grid">

          <article>
            <span class="personal-number">01 / READING</span>
            <h3>Ideas worth revisiting.</h3>
            <p>
              One of my favourite books is The Mastery of Self,
              which explores a Toltec perspective on
              self-understanding and personal freedom.
            </p>
          </article>

          <article>
            <span class="personal-number">02 / MUSIC</span>
            <h3>Finding rhythm.</h3>
            <p>
              I enjoy playing the harmonium — a creative
              outlet that offers a different kind of
              focus and expression.
            </p>
          </article>

          <article>
            <span class="personal-number">03 / ART</span>
            <h3>Creating on canvas.</h3>
            <p>
              Painting gives me space to explore
              ideas visually, experiment freely,
              and enjoy the process of creating.
            </p>
          </article>

        </div>
      </section>

      <!-- CLOSING -->

      <section class="closing">
        <p class="eyebrow">06 / THE JOURNEY CONTINUES</p>
        <h2>Always curious.<br /><em>Always becoming.</em></h2>
        <p>
          I'm continuing to explore the intersection of
          business, entrepreneurship, and social impact —
          and documenting what I learn along the way.
        </p>
        <a href="/" class="text-link">Back to home ↗</a>
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  /* PAGE LAYOUT */

  :global(body) main.about-page {
    width: min(90%, 1050px);
    max-width: 1050px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  .about-page * {
    box-sizing: border-box;
  }

  /* TYPOGRAPHY */

  .about-page .eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #8d533d;
    margin: 0 0 10px;
  }

  .about-page h1,
  .about-page h2,
  .about-page h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    line-height: 1.15;
    color: #252521;
  }

  .about-page h1 {
    font-size: clamp(32px, 3.2vw, 40px);
    letter-spacing: -0.7px;
    margin: 0 0 20px;
  }

  .about-page h1 em,
  .about-page h2 em {
    font-weight: 400;
  }

  .about-page h2 {
    font-size: clamp(25px, 2.5vw, 30px);
    margin: 0;
  }

  .about-page h3 {
    font-size: 22px;
    margin: 0 0 5px;
  }

  /* INTRODUCTION */

  .intro-section {
    padding: 26px 0 28px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
  }

  .intro-lead {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 20px;
    line-height: 1.45;
    color: #35312b;
    margin: 0;
  }

  .intro-copy p,
  .section-copy p {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: #625f58;
    margin: 0 0 12px;
  }

  .intro-copy p:last-child {
    margin-bottom: 0;
  }

  /* SHARED SECTIONS */

  .section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
  }

  .section-grid,
  .experience-section,
  .exploration-section,
  .personal-section,
  .closing {
    border-top: 1px solid #d8d2c7;
    padding: 24px 0 28px;
  }

  /* EDUCATION DETAIL */

  .detail {
    margin-top: 14px;
    padding: 16px 18px;
    background: #ebe6dc;
  }

  .detail span,
  .role,
  .personal-number {
    font-size: 10px;
    letter-spacing: 0.8px;
    color: #8d533d;
    font-weight: 600;
  }

  .detail strong {
    display: block;
    margin: 6px 0;
    font-size: 15px;
    font-weight: 600;
  }

  .detail p {
    font-size: 13px;
    margin: 3px 0;
    color: #625f58;
  }

  /* EXPERIENCE */

  .section-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    margin-bottom: 18px;
  }

  .section-heading p {
    font-size: 15px;
    color: #625f58;
    line-height: 1.55;
    margin: 0;
  }

  .experience-item {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 30px;
    padding: 15px 0;
    border-top: 1px solid #d8d2c7;
  }

  .experience-meta {
    display: flex;
    gap: 14px;
    font-size: 10px;
    letter-spacing: 0.8px;
    font-weight: 600;
    color: #8d533d;
    padding-top: 4px;
  }

  .experience-item .role {
    font-size: 11px;
    line-height: 1.4;
    margin: 0 0 6px;
  }

  .experience-item p:not(.role) {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: #625f58;
    line-height: 1.55;
    margin: 0;
  }

  /* CURRENT EXPLORATION */

  .exploration-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
  }

  .section-copy .reflection {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.45;
    color: #8d533d;
    margin-top: 16px;
  }

  /* PERSONAL INTERESTS */

  .personal-section h2 {
    margin-bottom: 18px;
  }

  .personal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .personal-grid article {
    background: #ebe6dc;
    padding: 18px;
  }

  .personal-grid h3 {
    font-size: 21px;
    margin: 12px 0 8px;
  }

  .personal-grid p {
    font-size: 14px;
    line-height: 1.5;
    color: #625f58;
    margin: 0;
  }

  /* CLOSING */

  .closing {
    text-align: center;
    padding: 30px 0 38px;
  }

  .closing h2 {
    font-size: 30px;
  }

  .closing p:not(.eyebrow) {
    max-width: 530px;
    margin: 12px auto;
    font-size: 15px;
    line-height: 1.55;
    color: #625f58;
  }

  .text-link {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: #8d533d;
    text-decoration: none;
    border-bottom: 1px solid #8d533d;
    padding-bottom: 3px;
  }

  /* TABLET */

  @media (max-width: 850px) {
    .intro-grid,
    .section-grid,
    .section-heading,
    .exploration-section {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .experience-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .personal-grid {
      grid-template-columns: 1fr;
    }
  }

  /* MOBILE */

  @media (max-width: 650px) {
    :global(body) main.about-page {
      width: calc(100% - 36px);
    }

    .intro-section {
      padding: 22px 0;
    }

    .about-page h1 {
      font-size: 34px;
    }

    .about-page h2 {
      font-size: 26px;
    }

    .section-grid,
    .experience-section,
    .exploration-section,
    .personal-section {
      padding: 22px 0;
    }

    .personal-grid {
      gap: 10px;
    }

    .closing {
      padding: 25px 0 30px;
    }
  }
</style>
