
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const experiences = [
  {
    number: '01',
    title: 'Corporate Transformation',
    organization: 'Singtel',
    description:
      'Spent a year working as a Corporate Transformation Manager, gaining exposure to how a large organization approaches change, strategy, and execution.',
  },
  {
    number: '02',
    title: 'Investment Management',
    organization: 'Helios Capital Management',
    description:
      'Completed a four-month investment internship in Singapore, exploring the analytical and decision-making processes behind investment management.',
  },
  {
    number: '03',
    title: 'Startups & Community',
    organization: 'Early-stage ventures',
    description:
      'Worked with startups across different stages and ideas, including an initiative focused on friendship and community-building in Singapore student life.',
  },
  {
    number: '04',
    title: 'Social Consulting & Leadership',
    organization: 'Do Well Do Good (DWDG), NTU',
    description:
      'Served as Training Director for a student-led social consulting club, helping members develop consulting skills and connecting with partner clubs globally.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Work & Impact | ${SITE_TITLE}`}
      description="Projects, experiences, and explorations by Charvi Aggarwal."
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="work-page">

      <section class="work-intro">
        <p class="eyebrow">
          EXPERIENCE / EXPLORATION / IMPACT
        </p>

        <h1>
          Work <em>&</em> Impact<span>.</span>
        </h1>

        <p class="intro-description">
          A collection of projects, experiences,
          and questions that have shaped how
          I approach problems.
        </p>
      </section>

      <!-- FEATURED PROJECT 01 -->

      <section class="featured-project">

        <div class="section-label">
          <span>01 / EXPLORING COMPLEX PROBLEMS</span>
          <div class="line"></div>
        </div>

        <div class="project-layout">

          <div class="project-heading">
            <p class="project-type">
              INDEPENDENT EXPLORATION
            </p>

            <h2>
              Beyond the<br />
              first idea.
            </h2>

            <p class="project-subtitle">
              Crop-residue burning in India
            </p>
          </div>

          <div class="project-story">
            <p>
              I began exploring the challenge of
              crop-residue burning with an initial
              idea for an app.
            </p>

            <p>
              But conversations with farmers and
              agricultural professionals made me
              realize that the problem was far more
              complex than I'd initially understood.
            </p>

            <p>
              The experience has encouraged me to
              look beyond an immediate solution
              and spend more time understanding
              the people, systems, and constraints
              involved.
            </p>

            <div class="project-status">
              <span class="status-dot"></span>
              EARLY-STAGE EXPLORATION
            </div>
          </div>

        </div>
      </section>

      <!-- FEATURED PROJECT 02 -->

      <section class="featured-project">

        <div class="section-label">
          <span>02 / STRATEGY & OPERATIONS</span>
          <div class="line"></div>
        </div>

        <div class="project-layout">

          <div class="project-heading">
            <p class="project-type">
              NTU PEAK LEADERSHIP PROGRAMME
            </p>

            <h2>
              Understanding<br />
              efficiency at scale.
            </h2>

            <p class="project-subtitle">
              Nxera / Singtel
            </p>
          </div>

          <div class="project-story">
            <p>
              Through the NTU PEAK Leadership
              Programme, I was selected to work
              on a consulting project with Nxera,
              part of Singtel.
            </p>

            <p>
              The project involved helping a senior
              director examine power usage
              efficiency in a data-centre context.
            </p>

            <p>
              It was an opportunity to learn about
              a technically complex industry while
              approaching the challenge through
              a business and consulting lens.
            </p>

            <div class="project-status">
              <span class="status-dot"></span>
              CONSULTING PROJECT
            </div>
          </div>

        </div>
      </section>

      <!-- EXPERIENCE SECTION -->

      <section class="experience-section">

        <div class="section-label">
          <span>03 / EXPERIENCES THAT SHAPED ME</span>
          <div class="line"></div>
        </div>

        <div class="experience-intro">
          <h2>
            Learning across<br />
            different worlds.
          </h2>

          <p>
            From investment management to
            corporate transformation, startups,
            and social consulting, I've been
            drawn to opportunities that push
            me into unfamiliar territory.
          </p>
        </div>

        <div class="experience-list">
          {
            experiences.map((experience) => (
              <article class="experience-row">

                <span class="experience-number">
                  {experience.number}
                </span>

                <div class="experience-details">
                  <h3>{experience.title}</h3>

                  <p class="organization">
                    {experience.organization}
                  </p>
                </div>

                <p class="experience-description">
                  {experience.description}
                </p>

              </article>
            ))
          }
        </div>

      </section>

      <!-- CLOSING -->

      <section class="work-ending">

        <p class="eyebrow">
          THE THREAD THROUGH IT ALL
        </p>

        <h2>
          Stay curious.<br />
          Keep creating.
        </h2>

        <p>
          Different industries, different challenges,
          and different perspectives — but a
          continuing desire to learn, build,
          and create meaningful impact.
        </p>

        <a href="/journal" class="journal-link">
          Explore my Journal <span>↗</span>
        </a>

      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  .work-page {
    width: min(90%, 1120px);
    margin: 0 auto;
    padding: 55px 0 65px;
    color: #252521;
  }

  /* INTRODUCTION */

  .work-intro {
    max-width: 850px;
    padding: 15px 0 75px;
  }

  .eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #8d533d;
    margin: 0;
  }

  .work-intro h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(48px, 6vw, 78px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -1px;
    margin: 20px 0 25px;
  }

  .work-intro h1 em,
  .work-intro h1 span {
    color: #8d533d;
  }

  .intro-description {
    max-width: 650px;
    font-size: 22px;
    line-height: 1.55;
    color: #625f58;
    margin: 0;
  }

  /* SECTION LABELS */

  .section-label {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 35px;
  }

  .section-label span {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: #8d533d;
    white-space: nowrap;
  }

  .line {
    flex: 1;
    height: 1px;
    background: #d8d2c7;
  }

  /* FEATURED PROJECTS */

  .featured-project {
    margin-bottom: 85px;
  }

  .project-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: start;
  }

  .project-type {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: #8d533d;
    margin: 0 0 20px;
  }

  .project-heading h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 400;
    line-height: 1.18;
    margin: 0 0 20px;
  }

  .project-subtitle {
    font-size: 17px;
    line-height: 1.5;
    color: #625f58;
    margin: 0;
  }

  .project-story p {
    font-size: 18px;
    line-height: 1.7;
    color: #625f58;
    margin: 0 0 18px;
  }

  .project-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-top: 1px solid #d8d2c7;
    padding-top: 18px;
    margin-top: 6px;

    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #8d533d;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8d533d;
    flex-shrink: 0;
  }

  /* EXPERIENCE SECTION */

  .experience-section {
    margin-bottom: 85px;
  }

  .experience-intro {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    margin-bottom: 40px;
    align-items: start;
  }

  .experience-intro h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(36px, 4vw, 50px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }

  .experience-intro p {
    font-size: 18px;
    line-height: 1.7;
    color: #625f58;
    margin: 0;
  }

  .experience-list {
    border-top: 1px solid #d8d2c7;
  }

  .experience-row {
    display: grid;
    grid-template-columns: 35px 0.9fr 1.1fr;
    gap: 25px;
    align-items: start;
    padding: 28px 0;
    border-bottom: 1px solid #d8d2c7;
  }

  .experience-number {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    color: #8d533d;
  }

  .experience-details h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 26px;
    font-weight: 400;
    line-height: 1.25;
    margin: 0 0 10px;
  }

  .organization {
    font-size: 15px;
    line-height: 1.5;
    color: #8d533d;
    margin: 0;
  }

  .experience-description {
    font-size: 18px;
    line-height: 1.7;
    color: #625f58;
    margin: 0;
  }

  /* ENDING */

  .work-ending {
    text-align: center;
    padding: 70px 20px 35px;
    border-top: 1px solid #d8d2c7;
  }

  .work-ending h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(42px, 5vw, 64px);
    font-weight: 400;
    line-height: 1.15;
    margin: 22px 0;
  }

  .work-ending > p:not(.eyebrow) {
    max-width: 620px;
    margin: 0 auto 30px;
    font-size: 19px;
    line-height: 1.7;
    color: #625f58;
  }

  .journal-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #8d533d;
    text-decoration: none;
    padding-bottom: 6px;
    border-bottom: 1px solid #8d533d;
  }

  .journal-link:hover {
    color: #693c2b;
  }

  /* TABLET AND MOBILE */

  @media (max-width: 800px) {
    .work-page {
      width: min(90%, 620px);
      padding-top: 35px;
    }

    .work-intro {
      padding-bottom: 60px;
    }

    .work-intro h1 {
      font-size: clamp(43px, 9vw, 62px);
    }

    .intro-description {
      font-size: 20px;
    }

    .project-layout,
    .experience-intro {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .featured-project {
      margin-bottom: 65px;
    }

    .section-label {
      margin-bottom: 28px;
    }

    .section-label span {
      font-size: 11px;
      white-space: normal;
    }

    .project-heading h2 {
      font-size: clamp(34px, 7vw, 44px);
    }

    .project-story p,
    .experience-intro p {
      font-size: 17px;
    }

    .experience-row {
      grid-template-columns: 25px 1fr;
      gap: 12px 18px;
      padding: 24px 0;
    }

    .experience-description {
      grid-column: 2;
      font-size: 17px;
    }

    .experience-details h3 {
      font-size: 25px;
    }

    .experience-section {
      margin-bottom: 65px;
    }

    .work-ending {
      padding: 55px 0 25px;
    }

    .work-ending > p:not(.eyebrow) {
      font-size: 17px;
    }
  }
</style>
