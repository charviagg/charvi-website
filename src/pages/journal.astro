
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Automatically get all blog posts, newest first.
const posts = (await getCollection('blog')).sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);

// The newest article becomes the featured story.
const featuredPost = posts[0];

// All remaining articles appear below.
const otherPosts = posts.slice(1);

// Format publication dates nicely.
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Journal | ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="journal-page">

      <!-- INTRODUCTION -->

      <section class="journal-intro">
        <h1>The Journal<span>.</span></h1>

        <p class="journal-description">
          A space for the things I'm learning,
          questioning, creating, and figuring
          out along the way.
        </p>
      </section>

      <!-- FEATURED STORY -->

      {
        featuredPost && (
          <section class="featured-section">
            <a
              class="featured-card"
              href={`/blog/${featuredPost.id}/`}
            >
              <div class="featured-content">
                <p class="post-date">
                  {formatDate(featuredPost.data.pubDate)}
                </p>

                <h2>{featuredPost.data.title}</h2>

                <p class="post-description">
                  {featuredPost.data.description}
                </p>

                <span class="read-link">
                  Read the story <span class="link-arrow" aria-hidden="true"></span>
                </span>
              </div>

              <div class="featured-art" aria-hidden="true">
                <span>notes on</span>
                <strong>becoming.</strong>
                <span class="art-number">001</span>
              </div>
            </a>
          </section>
        )
      }

      <!-- ALL OTHER ARTICLES -->

      <section class="all-posts">
        <div class="section-title-row">
          <h2>Every story, so far.</h2>
          <p>Reflections, experiences, and ideas.</p>
        </div>

        {
          posts.length === 0 ? (
            <p class="empty-message">
              The first story is on its way.
            </p>
          ) : otherPosts.length === 0 ? (
            <p class="empty-message">
              More stories coming soon.
            </p>
          ) : (
            <div class="posts-grid">
              {otherPosts.map((post, index) => (
                <a
                  class="post-card"
                  href={`/blog/${post.id}/`}
                >
                  <div class="card-top">
                    <span>
                      {String(index + 2).padStart(2, '0')}
                    </span>

                    <span>
                      {formatDate(post.data.pubDate)}
                    </span>
                  </div>

                  <h3>{post.data.title}</h3>

                  <p>{post.data.description}</p>

                  <span class="read-link">
                    Read entry <span class="link-arrow" aria-hidden="true"></span>
                  </span>
                </a>
              ))}
            </div>
          )
        }
      </section>

      <!-- CLOSING -->

      <section class="journal-ending">
        <h2>
          Still learning.<br />
          Still writing.
        </h2>

        <p>
          This space will grow with the experiences,
          questions, and ideas that shape me.
        </p>
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  /* PAGE LAYOUT */

  .journal-page {
    width: min(90%, 1050px);
    margin: 0 auto;
    padding: 26px 0 40px;
    color: var(--text-primary);
  }

  .journal-page * {
    box-sizing: border-box;
  }

  /* TYPOGRAPHY */

  .journal-page h1,
  .journal-page h2,
  .journal-page h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    line-height: 1.15;
    color: var(--text-primary);
  }

  /* INTRODUCTION */

  .journal-intro {
    padding: 0 0 24px;
    max-width: 750px;
  }

  .journal-intro h1 {
    font-size: clamp(32px, 3.2vw, 40px);
    letter-spacing: -0.7px;
    margin: 12px 0 14px;
  }

  .journal-intro h1 span {
    color: var(--accent);
  }

  .journal-description {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.65;
    max-width: 560px;
    color: var(--text-secondary);
    margin: 0;
  }

  /* SECTION DIVIDERS */

  /* FEATURED ARTICLE */

  .featured-section {
    margin-bottom: 28px;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    min-height: 210px;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border-color);
    overflow: hidden;
    transition: background 0.2s ease;
  }

  .featured-card:hover {
    background: var(--surface-hover);
  }

  .featured-content {
    padding: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .post-date {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    color: var(--accent);
    margin: 0 0 9px;
  }

  .featured-content h2 {
    font-size: clamp(24px, 2.5vw, 30px);
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .post-description {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0 0 14px;
  }

  .read-link {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
  }

  /* FEATURED GRAPHIC */

  .featured-art {
    background: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 210px;
    color: var(--accent);
    padding: 18px;
  }

  .featured-art > span:first-child {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 1.5px;
  }

  .featured-art strong {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 3vw, 42px);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.5px;
  }

  .art-number {
    position: absolute;
    bottom: 14px;
    right: 18px;
    font-size: 10px;
    letter-spacing: 1px;
  }

  /* ALL POSTS */

  .all-posts {
    margin-bottom: 28px;
  }

  .section-title-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  .section-title-row h2 {
    font-size: clamp(25px, 2.5vw, 30px);
    margin: 0;
  }

  .section-title-row > p {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  /* INDIVIDUAL POST CARDS */

  .post-card {
    min-height: 165px;
    padding: 18px;
    border: 1px solid var(--border-color);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: background 0.2s ease;
  }

  .post-card:hover {
    background: var(--surface-hover);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 10px;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .post-card h3 {
    font-size: 22px;
    line-height: 1.2;
    margin: 0 0 8px;
  }

  .post-card > p {
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0 0 12px;
  }

  .post-card .read-link {
    margin-top: auto;
  }

  .empty-message {
    font-size: 15px;
    color: var(--text-secondary);
    margin: 0;
  }

  /* ENDING */

  .journal-ending {
    text-align: center;
    padding: 28px 20px 24px;
    border-top: 1px solid var(--border-color);
  }

  .journal-ending h2 {
    font-size: 30px;
    margin: 12px 0;
  }

  .journal-ending > p:last-child {
    max-width: 500px;
    margin: 0 auto;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* TABLET AND MOBILE */

  @media (max-width: 800px) {
    .journal-page {
      width: min(90%, 620px);
      padding-top: 22px;
    }

    .journal-intro {
      padding-bottom: 22px;
    }

    .journal-intro h1 {
      font-size: 34px;
    }

    .featured-card {
      grid-template-columns: 1fr;
    }

    .featured-content {
      padding: 20px;
    }

    .featured-art {
      min-height: 145px;
    }

    .featured-art strong {
      font-size: 36px;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }

    .section-title-row {
      display: block;
    }

    .section-title-row > p {
      margin-top: 6px;
    }

    .post-card {
      min-height: 145px;
    }

    .journal-ending {
      padding: 24px 0;
    }
  }

  .journal-page {
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  .journal-intro h1 {
    font-size: clamp(2.3rem, 5vw, 3.45rem);
  }

  .featured-art {
    background:
      repeating-radial-gradient(ellipse at 120% -40%, transparent 0 20px, rgb(219 181 140 / 16%) 21px 22px, transparent 23px 34px),
      var(--indigo);
    color: var(--on-indigo);
  }

  .featured-card {
    border-radius: 2px 2px 1.5rem 2px;
  }
</style>
