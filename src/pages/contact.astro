
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Contact | ${SITE_TITLE}`}
      description="Get in touch with Charvi Aggarwal."
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="contact-page">

      <!-- INTRODUCTION -->

      <section class="contact-intro">
        <p class="eyebrow">LET'S CONNECT</p>

        <h1>
          Good things begin<br />
          with a conversation<span>.</span>
        </h1>

        <p class="intro-text">
          I'm always happy to connect with people
          who are curious about ideas, business,
          entrepreneurship, and creating
          meaningful impact.
        </p>
      </section>

      <!-- CONTACT CARDS -->

      <section class="contact-section">

        <div class="section-label">
          <span>01 / GET IN TOUCH</span>
          <div class="line"></div>
        </div>

        <div class="contact-grid">

          <!-- EMAIL -->

          <a
            class="contact-card"
            href="mailto:charvi038@gmail.com"
          >
            <div class="card-top">
              <span>EMAIL</span>
              <span class="arrow">↗</span>
            </div>

            <div class="card-content">
              <h2>Write to me.</h2>

              <p>
                For conversations, collaborations,
                or simply to say hello.
              </p>

              <span class="contact-detail">
                charvi038@gmail.com
              </span>
            </div>
          </a>

          <!-- LINKEDIN -->

          <a
            class="contact-card"
            href="https://www.linkedin.com/in/charvi537/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="card-top">
              <span>LINKEDIN</span>
              <span class="arrow">↗</span>
            </div>

            <div class="card-content">
              <h2>Let's connect.</h2>

              <p>
                Follow my professional journey,
                experiences, and the ideas
                I'm exploring.
              </p>

              <span class="contact-detail">
                linkedin.com/in/charvi537
              </span>
            </div>
          </a>

        </div>
      </section>

      <!-- CLOSING -->

      <section class="contact-ending">

        <p class="eyebrow">UNTIL THEN</p>

        <h2>
          Here's to ideas<br />
          worth exploring.
        </h2>

        <p>
          Thank you for taking the time
          to get to know a little about me.
        </p>

        <a href="/" class="home-link">
          Back to home <span>↗</span>
        </a>

      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  /* PAGE LAYOUT */

  .contact-page {
    width: min(90%, 1050px);
    margin: 0 auto;
    padding: 26px 0 40px;
    color: #252521;
  }

  .contact-page * {
    box-sizing: border-box;
  }

  /* EDITORIAL LABELS */

  .contact-page .eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #8d533d;
    margin: 0;
  }

  /* INTRODUCTION */

  .contact-intro {
    max-width: 750px;
    padding: 0 0 26px;
  }

  .contact-intro h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 3.2vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.7px;
    margin: 12px 0 14px;
  }

  .contact-intro h1 span {
    color: #8d533d;
  }

  .intro-text {
    max-width: 560px;
    font-size: 16px;
    line-height: 1.55;
    color: #625f58;
    margin: 0;
  }

  /* SECTION LABEL */

  .section-label {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .section-label span {
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #8d533d;
    white-space: nowrap;
  }

  .line {
    flex: 1;
    height: 1px;
    background: #d8d2c7;
  }

  /* CONTACT CARDS */

  .contact-section {
    margin-bottom: 28px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .contact-card {
    min-width: 0;
    min-height: 185px;
    padding: 20px;
    border: 1px solid #d8d2c7;
    text-decoration: none;
    color: #252521;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .contact-card:hover {
    background: #eee7dd;
    border-color: #8d533d;
    transform: translateY(-2px);
  }

  .contact-card:focus-visible {
    outline: 2px solid #8d533d;
    outline-offset: 4px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;

    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #8d533d;
  }

  .arrow {
    font-size: 18px;
    font-weight: 400;
  }

  .card-content h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 25px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 8px;
  }

  .card-content p {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #625f58;
    margin: 0 0 12px;
  }

  .contact-detail {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #8d533d;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* CLOSING */

  .contact-ending {
    text-align: center;
    padding: 28px 20px 24px;
    border-top: 1px solid #d8d2c7;
  }

  .contact-ending h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.15;
    margin: 12px 0;
  }

  .contact-ending > p:not(.eyebrow) {
    max-width: 500px;
    margin: 0 auto 15px;
    font-size: 15px;
    line-height: 1.55;
    color: #625f58;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #8d533d;
    text-decoration: none;

    padding-bottom: 3px;
    border-bottom: 1px solid #8d533d;
  }

  .home-link:hover {
    color: #693c2b;
  }

  /* TABLET AND MOBILE */

  @media (max-width: 800px) {
    .contact-page {
      width: min(90%, 620px);
      padding-top: 22px;
    }

    .contact-intro {
      padding-bottom: 22px;
    }

    .contact-intro h1 {
      font-size: 34px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-card {
      min-height: 165px;
      padding: 18px;
    }

    .contact-section {
      margin-bottom: 24px;
    }

    .contact-ending {
      padding: 24px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card {
      transition: none;
    }

    .contact-card:hover {
      transform: none;
    }
  }
</style>
