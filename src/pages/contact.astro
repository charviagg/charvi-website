
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Contact | ${SITE_TITLE}`}
      description="Get in touch with Charvi Aggarwal."
    />

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="contact-page">

      <!-- INTRODUCTION -->

      <section class="contact-intro">
        <p class="eyebrow">LET'S CONNECT</p>

        <h1>
          Good things begin<br />
          with a conversation<span>.</span>
        </h1>

        <p class="intro-text">
          I'm always happy to connect with people
          who are curious about ideas, business,
          entrepreneurship, and creating
          meaningful impact.
        </p>
      </section>

      <!-- CONTACT CARDS -->

      <section class="contact-section">

        <div class="section-label">
          <span>01 / GET IN TOUCH</span>
          <div class="line"></div>
        </div>

        <div class="contact-grid">

          <!-- EMAIL -->

          <a
            class="contact-card"
            href="mailto:charvi038@gmail.com"
          >
            <div class="card-top">
              <span>EMAIL</span>
              <span class="arrow">↗</span>
            </div>

            <div class="card-content">
              <h2>Write to me.</h2>

              <p>
                For conversations, collaborations,
                or simply to say hello.
              </p>

              <span class="contact-detail">
                charvi038@gmail.com
              </span>
            </div>
          </a>

          <!-- LINKEDIN -->

          <a
            class="contact-card"
            href="https://www.linkedin.com/in/charvi537/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="card-top">
              <span>LINKEDIN</span>
              <span class="arrow">↗</span>
            </div>

            <div class="card-content">
              <h2>Let's connect.</h2>

              <p>
                Follow my professional journey,
                experiences, and the ideas
                I'm exploring.
              </p>

              <span class="contact-detail">
                linkedin.com/in/charvi537
              </span>
            </div>
          </a>

        </div>
      </section>

      <!-- CLOSING -->

      <section class="contact-ending">

        <p class="eyebrow">UNTIL THEN</p>

        <h2>
          Here's to ideas<br />
          worth exploring.
        </h2>

        <p>
          Thank you for taking the time
          to get to know a little about me.
        </p>

        <a href="/" class="home-link">
          Back to home <span>↗</span>
        </a>

      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  .contact-page {
    width: min(90%, 1120px);
    margin: 0 auto;
    padding: 55px 0 65px;
    color: #252521;
  }

  /* EDITORIAL LABELS */

  .eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #8d533d;
    margin: 0;
  }

  /* INTRODUCTION */

  .contact-intro {
    max-width: 900px;
    padding: 15px 0 75px;
  }

  .contact-intro h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(44px, 5.5vw, 72px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -1px;
    margin: 20px 0 25px;
  }

  .contact-intro h1 span {
    color: #8d533d;
  }

  .intro-text {
    max-width: 680px;
    font-size: 22px;
    line-height: 1.6;
    color: #625f58;
    margin: 0;
  }

  /* SECTION LABEL */

  .section-label {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 30px;
  }

  .section-label span {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: #8d533d;
    white-space: nowrap;
  }

  .line {
    flex: 1;
    height: 1px;
    background: #d8d2c7;
  }

  /* CONTACT CARDS */

  .contact-section {
    margin-bottom: 85px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .contact-card {
    min-width: 0;
    min-height: 300px;
    padding: 32px;
    border: 1px solid #d8d2c7;
    text-decoration: none;
    color: #252521;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 35px;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .contact-card:hover {
    background: #eee7dd;
    border-color: #8d533d;
    transform: translateY(-3px);
  }

  .contact-card:focus-visible {
    outline: 2px solid #8d533d;
    outline-offset: 4px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;

    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: #8d533d;
  }

  .arrow {
    font-size: 23px;
    font-weight: 400;
  }

  .card-content h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 3.5vw, 44px);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 15px;
  }

  .card-content p {
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 1.65;
    color: #625f58;
    margin: 0 0 22px;
  }

  .contact-detail {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: #8d533d;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  /* CLOSING */

  .contact-ending {
    text-align: center;
    padding: 70px 20px 35px;
    border-top: 1px solid #d8d2c7;
  }

  .contact-ending h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(42px, 5vw, 62px);
    font-weight: 400;
    line-height: 1.15;
    margin: 22px 0;
  }

  .contact-ending > p:not(.eyebrow) {
    max-width: 600px;
    margin: 0 auto 28px;
    font-size: 19px;
    line-height: 1.65;
    color: #625f58;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #8d533d;
    text-decoration: none;

    padding-bottom: 6px;
    border-bottom: 1px solid #8d533d;
  }

  .home-link:hover {
    color: #693c2b;
  }

  /* TABLET AND MOBILE */

  @media (max-width: 800px) {
    .contact-page {
      width: min(90%, 620px);
      padding-top: 35px;
    }

    .contact-intro {
      padding-bottom: 55px;
    }

    .contact-intro h1 {
      font-size: clamp(40px, 8vw, 60px);
    }

    .intro-text {
      font-size: 20px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-card {
      min-height: 260px;
      padding: 27px;
    }

    .card-content h2 {
      font-size: 36px;
    }

    .card-content p {
      font-size: 17px;
    }

    .contact-section {
      margin-bottom: 65px;
    }

    .contact-ending {
      padding: 55px 0 25px;
    }

    .contact-ending > p:not(.eyebrow) {
      font-size: 17px;
    }

    .section-label span {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card {
      transition: none;
    }

    .contact-card:hover {
      transform: none;
    }
  }
</style>
