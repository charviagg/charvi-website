
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="homepage">

      <!-- HERO -->

      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">
            ENTREPRENEURSHIP / SOCIAL IMPACT / IDEAS
          </p>

          <h1>
            Curiosity, ideas
            <em>&amp; the passion</em>
            to build.
          </h1>

          <p class="intro">
            Hi, I'm Charvi. I'm exploring entrepreneurship,
            social impact, and the ideas that shape
            how we live, think, and work.
          </p>

          <a href="/about" class="text-link">
            A little about me <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="art-top">NOTES FROM THE JOURNEY</div>

          <div class="art-center">
            <span class="art-small">THE ART OF</span>
            <span class="art-large">becoming.</span>
            <div class="art-line"></div>
            <span class="art-quote">
              An ongoing collection of ideas,
              experiments &amp; discoveries.
            </span>
          </div>

          <div class="art-bottom">
            <span>CHARVI AGGARWAL</span>
            <span>EST. 2026</span>
          </div>
        </div>
      </section>

      <!-- ABOUT -->

      <section class="about section-grid">
        <div>
          <p class="eyebrow">01 / THE PERSON</p>
          <h2>A work in progress, always.</h2>
        </div>

        <div class="section-copy">
          <p>
            I believe meaningful ideas begin with curiosity.
            This is my little corner of the internet where
            I document what I'm building, what I'm learning,
            and the questions I'm asking along the way.
          </p>

          <a href="/about" class="text-link">
            More about me <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <!-- PROJECTS -->

      <section class="work" id="work">
        <div class="section-heading">
          <div>
            <p class="eyebrow">02 / SELECTED EXPLORATIONS</p>
            <h2>Things I'm working on.</h2>
          </div>

          <span class="section-note">
            A collection of ideas, projects &amp; reflections
          </span>
        </div>

        <div class="projects">
          <article class="project">
            <div class="project-top">
              <span>01 / SOCIAL IMPACT</span>
              <span aria-hidden="true">↗</span>
            </div>

            <div>
              <h3>Building with purpose.</h3>
              <p>
                Exploring how entrepreneurship can help
                address meaningful social challenges.
              </p>
            </div>

            <span class="project-category">
              ONGOING EXPLORATION
            </span>
          </article>

          <article class="project">
            <div class="project-top">
              <span>02 / FIELD NOTES</span>
              <span aria-hidden="true">↗</span>
            </div>

            <div>
              <h3>Notes from the journey.</h3>
              <p>
                Thoughts on entrepreneurship, creativity,
                leadership, and learning by doing.
              </p>
            </div>

            <a href="/journal" class="project-category">
              EXPLORE MY WRITING ↗
            </a>
          </article>
        </div>
      </section>

      <!-- CLOSING -->

      <section class="closing section-grid">
        <div>
          <p class="eyebrow">03 / WHAT'S NEXT</p>
          <h2>Still learning.<br />Still building.</h2>
        </div>

        <div class="section-copy">
          <p>
            This space will grow as I do — one idea,
            experiment, and experience at a time.
          </p>

          <a href="/journal" class="text-link">
            Read my field notes <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  /* HOMEPAGE LAYOUT */

  :global(body) main.homepage {
    width: min(90%, 1050px);
    max-width: 1050px;
    margin: 0 auto;
    padding: 0;
  }

  .homepage * {
    box-sizing: border-box;
  }

  .homepage .eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #8d533d;
    margin: 0 0 10px;
  }

  .homepage h1,
  .homepage h2,
  .homepage h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    color: #252521;
    line-height: 1.15;
  }

  /* COMPACT HERO */

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 45px;
    align-items: center;
    padding: 24px 0 28px;
  }

  .hero-content {
    min-width: 0;
  }

  .homepage h1 {
    font-size: clamp(32px, 3.2vw, 40px);
    letter-spacing: -0.7px;
    margin: 0 0 14px;
  }

  .homepage h1 em {
    display: block;
    font-weight: 400;
  }

  .homepage .intro {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.55;
    color: #625f58;
    max-width: 440px;
    margin: 0 0 14px;
  }

  .text-link {
    display: inline-block;
    color: #8d533d;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #8d533d;
    padding-bottom: 3px;
  }

  .text-link:hover {
    color: #252521;
    border-color: #252521;
  }

  /* SMALLER ART PANEL */

  .hero-art {
    background: #ded5c7;
    height: 240px;
    min-height: 0;
    padding: 18px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    color: #433d36;
  }

  .art-top,
  .art-bottom {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .art-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .art-small {
    font-size: 10px;
    letter-spacing: 1.5px;
    margin-bottom: 4px;
  }

  .art-large {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 36px;
    line-height: 1.1;
  }

  .art-line {
    width: 35px;
    height: 1px;
    background: #8d533d;
    margin: 12px 0;
  }

  .art-quote {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 13px;
    line-height: 1.4;
    max-width: 210px;
  }

  .art-bottom {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  /* COMPACT SECTIONS */

  .section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    align-items: start;
  }

  .about,
  .work,
  .closing {
    border-top: 1px solid #d8d2c7;
    padding: 24px 0 26px;
  }

  .homepage h2 {
    font-size: clamp(25px, 2.5vw, 30px);
    margin: 0;
  }

  .section-copy {
    padding-top: 4px;
  }

  .homepage .section-copy p {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    line-height: 1.55;
    color: #625f58;
    margin: 0 0 12px;
  }

  /* PROJECTS */

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 16px;
  }

  .section-note {
    font-size: 11px;
    color: #817b72;
    max-width: 180px;
    text-align: right;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .project {
    background: #ebe6dc;
    padding: 18px;
    min-height: 155px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: #8d533d;
  }

  .homepage h3 {
    font-size: 23px;
    margin: 10px 0 6px;
  }

  .homepage .project p {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #625f58;
    margin: 0;
  }

  .project-category {
    color: #8d533d;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    margin-top: 12px;
    text-decoration: none;
  }

  /* TABLET */

  @media (max-width: 850px) {
    .hero {
      gap: 24px;
    }

    .section-grid {
      gap: 24px;
    }
  }

  /* MOBILE */

  @media (max-width: 650px) {
    :global(body) main.homepage {
      width: calc(100% - 36px);
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 22px 0;
    }

    .homepage h1 {
      font-size: 34px;
    }

    .hero-art {
      height: 210px;
    }

    .section-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .section-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .section-note {
      text-align: left;
      max-width: none;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .project {
      min-height: 145px;
    }

    .about,
    .work,
    .closing {
      padding: 22px 0;
    }

    .homepage h2 {
      font-size: 26px;
    }
  }
</style>
