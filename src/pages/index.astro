
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />

    <main class="homepage">

      <!-- HERO -->
      <section class="hero">

        <div class="hero-content">
          <p class="eyebrow">
            ENTREPRENEURSHIP / SOCIAL IMPACT / IDEAS
          </p>

          <h1>
            Curiosity, ideas
            <em>&amp; the passion</em>
            to build.
          </h1>

          <p class="intro">
            Hi, I'm Charvi. I'm exploring entrepreneurship,
            social impact, and the ideas that shape
            how we live, think, and work.
          </p>

          <a href="/about" class="text-link">
            A little about me <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="art-top">NOTES FROM THE JOURNEY</div>

          <div class="art-center">
            <span class="art-small">THE ART OF</span>
            <span class="art-large">becoming.</span>
            <div class="art-line"></div>
            <span class="art-quote">
              An ongoing collection of ideas,
              experiments &amp; discoveries.
            </span>
          </div>

          <div class="art-bottom">
            <span>CHARVI AGGARWAL</span>
            <span>EST. 2026</span>
          </div>
        </div>

      </section>

      <!-- ABOUT -->
      <section class="about section-grid">
        <div>
          <p class="eyebrow">01 / THE PERSON</p>
          <h2>A work in progress, always.</h2>
        </div>

        <div class="section-copy">
          <p>
            I believe meaningful ideas begin with curiosity.
            This is my little corner of the internet where
            I document what I'm building, what I'm learning,
            and the questions I'm asking along the way.
          </p>

          <a href="/about" class="text-link">
            More about me <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <!-- PROJECTS -->
      <section class="work" id="work">

        <div class="section-heading">
          <div>
            <p class="eyebrow">02 / SELECTED EXPLORATIONS</p>
            <h2>Things I'm working on.</h2>
          </div>

          <span class="section-note">
            A collection of ideas, projects &amp; reflections
          </span>
        </div>

        <div class="projects">

          <article class="project">
            <div class="project-top">
              <span>01 / SOCIAL IMPACT</span>
              <span aria-hidden="true">↗</span>
            </div>

            <div>
              <h3>Building with purpose.</h3>
              <p>
                Exploring how entrepreneurship can help
                address meaningful social challenges.
              </p>
            </div>

            <span class="project-category">
              ONGOING EXPLORATION
            </span>
          </article>

          <article class="project">
            <div class="project-top">
              <span>02 / FIELD NOTES</span>
              <span aria-hidden="true">↗</span>
            </div>

            <div>
              <h3>Notes from the journey.</h3>
              <p>
                Thoughts on entrepreneurship, creativity,
                leadership, and learning by doing.
              </p>
            </div>

            <a href="/blog" class="project-category">
              EXPLORE MY WRITING ↗
            </a>
          </article>

        </div>
      </section>

      <!-- CLOSING -->
      <section class="closing section-grid">
        <div>
          <p class="eyebrow">03 / WHAT'S NEXT</p>
          <h2>Still learning.<br />Still building.</h2>
        </div>

        <div class="section-copy">
          <p>
            This space will grow as I do — one idea,
            experiment, and experience at a time.
          </p>

          <a href="/blog" class="text-link">
            Read my field notes <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #f7f4ed;
    color: #252521;
    font-family: 'DM Sans', sans-serif;
    font-size: 18px;
    line-height: 1.6;
  }

  :global(body) main.homepage {
    width: min(92%, 1400px);
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  .homepage * {
    box-sizing: border-box;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #8d533d;
    margin: 0 0 25px;
  }

  h1, h2, h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    color: #252521;
    line-height: 1.12;
  }

  /* HERO */

  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 6%;
    align-items: center;
    padding: 65px 0 75px;
  }

  .hero-content {
    max-width: 750px;
  }

  h1 {
    font-size: clamp(54px, 5.4vw, 88px);
    letter-spacing: -2px;
    margin: 0 0 28px;
  }

  h1 em {
    display: block;
    font-weight: 400;
  }

  .intro {
    font-size: clamp(19px, 1.5vw, 22px);
    line-height: 1.65;
    color: #625f58;
    max-width: 600px;
    margin: 0 0 28px;
  }

  .text-link {
    display: inline-block;
    color: #8d533d;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #8d533d;
    padding-bottom: 5px;
  }

  .text-link:hover {
    color: #252521;
    border-color: #252521;
  }

  /* EDITORIAL ART PANEL */

  .hero-art {
    background: #ded5c7;
    min-height: 420px;
    aspect-ratio: 4 / 4.2;
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #433d36;
  }

  .art-top,
  .art-bottom {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
  }

  .art-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .art-small {
    font-size: 12px;
    letter-spacing: 3px;
    margin-bottom: 5px;
  }

  .art-large {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(45px, 5vw, 76px);
    line-height: 1.2;
  }

  .art-line {
    width: 55px;
    height: 1px;
    background: #8d533d;
    margin: 28px 0;
  }

  .art-quote {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    line-height: 1.5;
    max-width: 270px;
  }

  .art-bottom {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }

  /* SHARED SECTIONS */

  .section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8%;
    align-items: start;
  }

  .about,
  .work,
  .closing {
    border-top: 1px solid #d8d2c7;
    padding: 55px 0 65px;
  }

  h2 {
    font-size: clamp(36px, 3.6vw, 56px);
    margin: 0;
  }

  .section-copy {
    padding-top: 20px;
  }

  .section-copy p {
    font-size: 20px;
    line-height: 1.7;
    color: #625f58;
    margin: 0 0 25px;
  }

  /* PROJECTS */

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 35px;
  }

  .section-note {
    font-size: 14px;
    color: #817b72;
    max-width: 240px;
    text-align: right;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
  }

  .project {
    background: #ebe6dc;
    padding: 35px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .project-top {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
    color: #8d533d;
  }

  h3 {
    font-size: clamp(28px, 2.8vw, 42px);
    margin: 25px 0 12px;
  }

  .project p {
    font-size: 18px;
    line-height: 1.6;
    color: #625f58;
    max-width: 460px;
    margin: 0;
  }

  .project-category {
    color: #8d533d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-top: 25px;
    text-decoration: none;
  }

  /* MOBILE */

  @media (max-width: 850px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 55px 0;
    }

    .hero-art {
      min-height: 330px;
      aspect-ratio: auto;
    }

    .section-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .section-copy {
      padding-top: 0;
    }

    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .section-note {
      text-align: left;
    }
  }

  @media (max-width: 600px) {
    :global(body) main.homepage {
      width: calc(100% - 36px);
    }

    .hero {
      padding: 45px 0;
    }

    h1 {
      font-size: clamp(42px, 11vw, 58px);
      letter-spacing: -1px;
    }

    .eyebrow {
      font-size: 10px;
      letter-spacing: 1.4px;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .project {
      min-height: 260px;
      padding: 25px;
    }

    .about,
    .work,
    .closing {
      padding: 40px 0;
    }

    .section-copy p {
      font-size: 18px;
    }

    .art-large {
      font-size: 55px;
    }
  }
</style>
