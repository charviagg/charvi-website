      <div class="bar-column"><span class="bar-value">71,304</span><div class="bar" style="--bar-height: 85.9%"></div><strong>2021</strong></div>
      <div class="bar-column"><span class="bar-value">49,922</span><div class="bar" style="--bar-height: 60.1%"></div><strong>2022</strong></div>
